{
  "extends": "@curaos/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "react"],
    // react.json sets `jsx: preserve` (it targets the Astro/Next bundler that
    // does its own JSX transform). This package is a published library compiled
    // by `tsc`, so it must emit runnable .js, not raw .jsx. `react-jsx` uses the
    // React 19 automatic runtime (`react/jsx-runtime`), no React import needed.
    "jsx": "react-jsx",
    // The hey-api fetch SDKs pass `{ x: undefined }` for optional fields
    // rather than omitting the key (known hey-api shape), so the same
    // single-package relaxation the sibling *-sdk tsconfigs document applies
    // here too. Type SAFETY (strict, strictNullChecks, noImplicitAny) stays ON.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "test", "dist", "node_modules"]
}
